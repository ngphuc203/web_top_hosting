<?php
session_start();

// Thông tin kết nối cơ sở dữ liệu MySQL
$servername = "localhost";
$username = "root";
$password = "";
$database = "doanv2"; // Tên cơ sở dữ liệu của bạn

// Kết nối MySQL
$conn = new mysqli($servername, $username, $password, $database);

// Kiểm tra kết nối
if ($conn->connect_error) {
    die("Kết nối thất bại: " . $conn->connect_error);
}

// Xử lý xóa sản phẩm
if (isset($_POST['delete'])) {
    $productId = $_POST['delete'];

    // Xóa sản phẩm khỏi cơ sở dữ liệu
    $stmt = $conn->prepare("DELETE FROM products WHERE product_id = ?");
    $stmt->bind_param("i", $productId);  // Sử dụng "i" cho kiểu INT
    $stmt->execute();
    $stmt->close();

    $_SESSION['message'] = "Sản phẩm đã được xóa thành công!";
    header("Location: manage_products.php");
    exit;
}

// Xử lý thêm sản phẩm
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (isset($_POST['add'])) {
        // Thêm sản phẩm mới
        $productName = $_POST['product_name'];
        $productDesc = $_POST['product_desc'];
        $productPrice = $_POST['product_price'];
        $productQty = $_POST['product_qty'];
        $productImage = null;

        // Xử lý hình ảnh nếu có tải lên
        if (isset($_FILES['product_image']) && $_FILES['product_image']['error'] === UPLOAD_ERR_OK) {
            $imageName = uniqid() . '_' . $_FILES['product_image']['name'];
            $imageTmp = $_FILES['product_image']['tmp_name'];
            $imagePath = 'uploads/' . $imageName;
            move_uploaded_file($imageTmp, $imagePath);
            $productImage = $imagePath;
        }

        // Thêm sản phẩm mới vào cơ sở dữ liệu
        $stmt = $conn->prepare("INSERT INTO products (name, description, price, quantity, image) VALUES (?, ?, ?, ?, ?)");
        $stmt->bind_param("sssds", $productName, $productDesc, $productPrice, $productQty, $productImage);
        $stmt->execute();
        $stmt->close();

        $_SESSION['message'] = "Sản phẩm đã được thêm thành công!";
        header("Location: manage_products.php");
        exit;
    }

    // Cập nhật sản phẩm
    if (isset($_POST['update_products'])) {
        $updatedProducts = $_POST['products'];

        // Cập nhật từng sản phẩm
        foreach ($updatedProducts as $updatedProduct) {
            $productId = $updatedProduct['product_id'];  // Sử dụng product_id
            $productName = $updatedProduct['name'];
            $productDesc = $updatedProduct['description'];
            $productPrice = (float)$updatedProduct['price'];
            $productQty = (int)$updatedProduct['quantity'];

            // Cập nhật sản phẩm trong cơ sở dữ liệu
            $stmt = $conn->prepare("UPDATE products SET name = ?, description = ?, price = ?, quantity = ? WHERE product_id = ?");
            $stmt->bind_param("ssdsi", $productName, $productDesc, $productPrice, $productQty, $productId);
            $stmt->execute();
            $stmt->close();
        }

        $_SESSION['message'] = "Cập nhật sản phẩm thành công!";
        header("Location: manage_products.php");
        exit;
    }
}

// Lấy danh sách sản phẩm từ cơ sở dữ liệu
$result = $conn->query("SELECT * FROM products");
$products = [];
if ($result->num_rows > 0) {
    while ($row = $result->fetch_assoc()) {
        $products[] = $row;
    }
}
$conn->close();
?>

